# =================================================================
# WhatsOmni Unified Production Docker Environment Configuration
# =================================================================

# -----------------------------------------------------------------
# 1. Application Settings
# -----------------------------------------------------------------
APP_NAME=WhatsOmni
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:7B5Y+m8Vp2Vv9dD5QhJ9M4W1xZ3vK2nL6sY4wP8tQ0r=

# Set your public production domain names (e.g. https://yourdomain.com)
APP_URL=http://localhost
FRONTEND_URL=http://localhost
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# HTTP / HTTPS Port Bindings on Host
HTTP_PORT=80
HTTPS_PORT=443

# Automatic database migrations & configuration caching on container startup
RUN_MIGRATIONS=true
CACHE_ON_STARTUP=true

# -----------------------------------------------------------------
# 2. Database Configuration (MySQL 8.0)
# -----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=whatsomni
DB_USERNAME=whatsomni
DB_PASSWORD=whatsomni_secure_password_change_me
DB_ROOT_PASSWORD=root_secure_password_change_me

# -----------------------------------------------------------------
# 3. Cache, Queue & Session Storage (Redis 7.0)
# -----------------------------------------------------------------
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# -----------------------------------------------------------------
# 4. Laravel Reverb WebSockets (Real-time events)
# -----------------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=whatsomni_app_id
REVERB_APP_KEY=whatsomni_reverb_key_change_me
REVERB_APP_SECRET=whatsomni_reverb_secret_change_me
REVERB_HOST=localhost
REVERB_PORT=80
REVERB_SCHEME=http

# -----------------------------------------------------------------
# 5. Frontend Client-Side Environment Variables (Next.js)
# -----------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=http://localhost
NEXT_PUBLIC_REVERB_APP_KEY=whatsomni_reverb_key_change_me
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=80
NEXT_PUBLIC_REVERB_SCHEME=http

# -----------------------------------------------------------------
# 6. WhatsApp Baileys Worker
# -----------------------------------------------------------------
BAILEYS_WORKER_URL=http://baileys:5006
BAILEYS_SECRET_TOKEN=whatsomni_baileys_secret_key
LARAVEL_API_URL=http://nginx:80

# -----------------------------------------------------------------
# 7. System Transactional Mailer (SMTP / Resend)
# -----------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@whatsomni.com
MAIL_FROM_NAME=WhatsOmni

# Resend API Key (Optional alternative mailer)
RESEND_API_KEY=null

# -----------------------------------------------------------------
# 8. Full-Text & Vector Search (Laravel Scout)
# -----------------------------------------------------------------
# Supported drivers: collection (default, lightweight built-in), database, meilisearch
SCOUT_DRIVER=collection
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=masterKey123
